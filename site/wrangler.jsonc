{
  // Ground Truth: one Worker in front of everything (login, progress API, static files).
  "name": "ground-truth",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "kv_namespaces": [{ "binding": "PROGRESS", "id": "REPLACED_AT_DEPLOY" }],
  "observability": { "enabled": true }
}
